# Backend
DATABASE_URL=postgresql+asyncpg://dclaw:dclaw@localhost:5432/dclaw_seo
APP_ENV=dev
DEBUG=true

# AI / LLM — configure one or both providers (see backend/app/services/llm.py)
# LLM_PROVIDER: "auto" (ollama then openrouter fallback) | "ollama" | "openrouter"
LLM_PROVIDER=auto
# Ollama (local) — point at your running instance
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OpenRouter (cloud) — paste your token here
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_TIMEOUT_SECONDS=60

# Core Web Vitals — Google PageSpeed Insights (optional free key for quota)
PAGESPEED_API_KEY=

# Local SEO — Google Business Profile (optional; enables live GBP sync)
GBP_API_KEY=

# White-label report email delivery (optional; reports still generate without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@dclaw-seo.local

# Auth (self-contained JWT)
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM cost metering — per-1k-token rate (local Ollama is $0 but still metered)
LLM_COST_PER_1K_TOKENS_USD=0.0

# Billing (Stripe) — optional; local invoice math works without it
STRIPE_API_KEY=
STRIPE_BASE_URL=https://api.stripe.com/v1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8095
