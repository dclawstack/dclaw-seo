# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_seo
APP_ENV=dev
DEBUG=true

# AI / LLM — configure one or both providers (see backend/app/services/llm.py)
# LLM_PROVIDER: "auto" (ollama then openrouter fallback) | "ollama" | "openrouter"
LLM_PROVIDER=auto
# Ollama (local) — point at your running instance
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OpenRouter (cloud) — paste your token here
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_TIMEOUT_SECONDS=60

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8095
